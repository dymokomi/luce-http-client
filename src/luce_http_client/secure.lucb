## HTTP/1.1 over native TLS with explicitly pinned issuer trust; no public CA store.
import session as tls
import net
import luce_http_client.framing as framing

pub let invalid = net.http_invalid

pub struct Response:
    pub var status: u16
    pub var length: usize

## One bounded request; output is untrusted and must be discarded on any error.
pub func fetch(host: str, port: u16, issuer_x: const u8[], issuer_y: const u8[],
               method: str, target: str, authorization: str, content_type: str,
               body: const u8[], output: u8[]) -> Response!:
    var request: u8[8192]
    var fields: net.HttpField[3]
    var count: usize = 1
    fields[0] = net.HttpField(name = "Host", value = host)
    if authorization.length > 0:
        fields[count] = net.HttpField(name = "Authorization", value = authorization)
        count += 1
    if content_type.length > 0:
        fields[count] = net.HttpField(name = "Content-Type", value = content_type)
        count += 1
    var head = net.HttpHead(method = method, target = target, version = "HTTP/1.1", fields = fields[..<count], keep_alive = false)
    if body.length > 0:
        head.body_kind = net.HttpBodyKind.fixed
        head.body_length = (u64)body.length
    let encoded = try net.http_encode_head(request, head)
    var secrets = tls.Secrets()
    var conn = try tls.connect(host, port, issuer_x, issuer_y, &secrets)
    defer discard(conn.close() catch: recover ())
    try tls.send(&conn, &secrets, encoded)
    var sent: usize = 0
    while sent < body.length:
        let size = 16384 if body.length - sent > 16384 else body.length - sent
        try tls.send(&conn, &secrets, body[sent..<sent + size])
        sent += size
    var response = try framing.Decoder.create()
    var incoming: u8[16640]
    while not response.finished():
        let got = try tls.receive(&conn, &secrets, incoming)
        if got == 0: break
        try response.consume(incoming[..<got], output, method)
    try response.finish()
    return Response(status = response.status, length = response.count)
