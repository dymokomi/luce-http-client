import luce_http_client.framing as framing
import https
import net

func decode(wire: const u8[], stride: usize, output: u8[], method: str = "GET") -> usize!:
    var decoder = try framing.Decoder.create()
    var at: usize = 0
    while at < wire.length:
        let n = stride if stride < wire.length - at else wire.length - at
        try decoder.consume(wire[at..<at + n], output, method)
        at += n
    try decoder.finish()
    assert(decoder.status == 200)
    return decoder.count

func rejects(wire: const u8[]) -> !:
    var output: u8[16]
    for stride in [1, 7, 1024]:
        var rejected = false
        discard(decode(wire, (usize)stride, output) catch failure:
            discard(failure)
            rejected = true
            recover 0)
        assert(rejected)

pub func main(arguments: str[]) -> i32!:
    discard(arguments)
    let fixed = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"
    let chunked = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2;foo=bar\r\nhe\r\n3\r\nllo\r\n0\r\nX-Test: yes\r\n\r\n"
    let eof = b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nhello"
    let interim = b"HTTP/1.1 103 Early Hints\r\n\r\nHTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"
    var output: u8[16]
    for wire in [fixed, chunked, eof, interim]:
        for stride in 1..<wire.length + 1:
            let n = try decode(wire, stride, output)
            assert(n == 5 and (str)output[..<n] == "hello")
    for wire in [fixed, chunked]:
        for length in 0..<wire.length:
            try rejects(wire[..<length])
    for wire in [b"HTTP/1.1 200 OK\r\nContent-Length: 17\r\n\r\n",
                 b"HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Length: 2\r\n\r\nx",
                 b"HTTP/1.1 200 OK\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\nx",
                 b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nZ\r\n",
                 b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1\r\nxZZ0\r\n\r\n",
                 b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nFFFFFFFFFFFFFFFFF\r\n",
                 b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n0\r\nContent-Length: 1\r\n\r\n",
                 b"HTTP/1.1 200 OK\r\n\r\n01234567890123456",
                 b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\n\r\nextra",
                 b"HTTP/1.1 101 Switching Protocols\r\n\r\n",
                 b"HTTP/1.1 XYZ OK\r\n\r\n"]:
        try rejects(wire)
    assert(try decode(b"HTTP/1.1 200 OK\r\nContent-Length: 9999\r\n\r\n", 1, output, "HEAD") == 0)
    # Invalid request header must fail before DNS or any connection attempt.
    var key: u8[32]
    var rejected = false
    discard(https.fetch("invalid\r\nInjected: yes", 1, key, key, "GET", "/", "", "", b"", output) catch failure:
        assert(failure.code == net.http_invalid)
        rejected = true
        recover https.Response())
    assert(rejected)
    rejected = false
    discard(https.fetch_public("invalid\r\nInjected: yes", 1, "GET", "/", "", "", b"", output) catch failure:
        assert(failure.code == net.http_invalid)
        rejected = true
        recover https.Response())
    assert(rejected)
    var root: u8[48]
    rejected = false
    discard(https.fetch_p384_chain("invalid\r\nInjected: yes", 1, root, root,
        "GET", "/", "", "", b"", output) catch failure:
        assert(failure.code == net.http_invalid)
        rejected = true
        recover https.Response())
    assert(rejected)
    print("PASS shared HTTP framing: fragmentation, truncation, chunks, limits and request injection")
    return 0
