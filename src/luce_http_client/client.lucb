## Cleartext HTTP/1.1 client. Numeric IPv4 peers only. No DNS, TLS or redirects.
import io
import memory
import net

pub let invalid = net.http_invalid
pub let limit_exceeded = net.http_limit
pub let max_response: usize = 1048576

pub struct Result:
    pub var status: u16
    pub var count: usize

func put_field(fields: net.HttpField[], used: usize*, name: str, value: str) -> !:
    if *used >= fields.length: error(invalid, "too many HTTP request fields")
    fields[*used] = net.HttpField(name = name, value = value)
    *used += 1

pub func request(address: net.SocketAddress, method: str, target: str, host: str,
    extra: const net.HttpField[], extra_count: usize, body: const u8[], output: u8[]) -> Result!:
    if extra_count > extra.length: error(invalid, "HTTP extra field count")
    if output.length > max_response: error(limit_exceeded, "HTTP response buffer exceeds 1 MiB")
    var conn = try net.Connection.connect(address)
    defer discard(conn.close() catch: recover ())
    var fields: net.HttpField[16]
    var n: usize
    try put_field(fields, &n, "Host", host)
    for i in 0..<extra_count:
        try put_field(fields, &n, extra[i].name, extra[i].value)
    var head = net.HttpHead(method = method, target = target, version = "HTTP/1.1",
        fields = fields[..<n], keep_alive = false)
    if body.length > 0:
        head.body_kind = net.HttpBodyKind.fixed
        head.body_length = (u64)body.length
    var wire: u8[4096]
    let encoded = try net.http_encode_head(wire, head)
    try io.write_all(&conn, encoded)
    if body.length > 0: try io.write_all(&conn, body)
    try conn.shutdown(net.ShutdownDirection.write)
    var incoming: u8[65536]
    var used: usize
    while used < incoming.length:
        let got = try conn.read(incoming[used..])
        if got == 0: break
        used += got
        if net.http_head_end(incoming[..<used]) != none: break
    let end = net.http_head_end(incoming[..<used]) else error(invalid, "incomplete HTTP response head")
    var parsed: net.HttpField[32]
    let response = try net.http_parse_response(incoming[..<end], parsed, method)
    var take = used - end
    if take > output.length: error(limit_exceeded, "HTTP response body is larger than the output buffer")
    for i in 0..<take: output[i] = incoming[end + i]
    if response.body_kind == net.HttpBodyKind.fixed:
        let need = (usize)response.body_length
        if need > output.length: error(limit_exceeded, "HTTP response body is larger than the output buffer")
        while take < need:
            let got = try conn.read(output[take..<need])
            if got == 0: error(invalid, "truncated HTTP response body")
            take += got
        return Result(status = response.status, count = need)
    return Result(status = response.status, count = take)

pub func get(port: u16, target: str, output: u8[]) -> Result!:
    var unused: net.HttpField[1]
    return try request(net.SocketAddress.loopback(port), "GET", target, "127.0.0.1", unused, 0, b"", output)

pub func post(port: u16, target: str, body: const u8[], output: u8[]) -> Result!:
    var unused: net.HttpField[1]
    return try request(net.SocketAddress.loopback(port), "POST", target, "127.0.0.1", unused, 0, body, output)
