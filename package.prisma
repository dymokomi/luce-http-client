#prisma 4.0
def package "luce-http-client" {
    str owner = "dymokomi"
    str version = "0.5.1"
    str kind = "package"
    str language = "luce-base"
    str description = "Native Luce Base HTTP/1.1 client. MIT OR Apache-2.0. Cleartext requests use numeric IPv4 addresses. The https export uses native TLS 1.3. https.fetch retains an explicitly supplied P-256 issuer pin for private servers."
    str readme = "README.md"
    str[] public = ["client", "secure"]

    def dependency "luce-tls" {
        str owner = "dymokomi"
        str path = "../luce-tls"
    }

    def dependency "luce-crypto" {
        str owner = "dymokomi"
        str path = "../luce-crypto"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str path = "../luce-std"
    }
}
